# Tailscale Serve (tailnet-only; no Funnel)
TS_AUTHKEY=tskey-auth-REPLACE_ME
TS_CERT_DOMAIN=looparr.tail0307d.ts.net
TS_EXTRA_ARGS=

# Host port mapped to the app through the Tailscale sidecar namespace
LOOPARR_LOCAL_PORT=4188

# App user and mounted project root
PUID=1000
PGID=1000
LOOPARR_PROJECTS_ROOT=/home/michaelpeele/ai-projects

# Host executor bridge (AI CLIs stay on the host)
LOOPARR_EXECUTOR_URL=http://172.17.0.1:4187
LOOPARR_EXECUTOR_TOKEN=REPLACE_WITH_32_BYTE_RANDOM_TOKEN

# Optional host-executor overrides
# LOOPARR_EXECUTOR_BIND=172.17.0.1
# LOOPARR_EXECUTOR_OPENCODE_BIN=/home/michaelpeele/.opencode/bin/opencode

# Password used when the host executor attaches to a password-protected OpenCode service.
# OPENCODE_PASSWORD=
