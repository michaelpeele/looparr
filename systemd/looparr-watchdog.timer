[Unit]
Description=Looparr watchdog timer (30-second recovery sweep)
Documentation=file:///home/michaelpeele/ai-projects/looparr/.project_documents/PLAN-watchdog-timer.md
# Triggers looparr-watchdog.service every 30 seconds, which runs scripts/restart-watchdog.sh timer.

[Timer]
OnBootSec=1min
OnUnitActiveSec=30s
Persistent=true
Unit=looparr-watchdog.service

[Install]
WantedBy=timers.target